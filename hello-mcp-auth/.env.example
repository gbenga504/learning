# Copy this file to .env and adjust if you like.

# The shared secret used to SIGN and VERIFY the JWT.
# In a real OAuth 2.1 setup the signing key lives only on the authorization
# server and the MCP server verifies with a PUBLIC key (see README). Here we
# use one shared secret (HS256) to keep the example to a single value.
MCP_JWT_SECRET=dev-only-super-secret-change-me

# Logical name of who issued the token and who it is for. The server checks
# these so a token minted for a different audience is rejected.
MCP_JWT_ISSUER=hello-mcp-auth-dev
MCP_JWT_AUDIENCE=hello-mcp-auth

# Port the HTTP server listens on.
PORT=8765
